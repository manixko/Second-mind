
{
    "id": "static_ip",
    "name": "Static IP Address",
    "description": "Configure a static IP address on an interface",

    "inputs": [
        {
            "name": "interface",
            "label": "Interface",
            "type": "string",
            "required": true,
            "pattern": "[a-zA-Z0-9_-]+"
        },
        {
            "name": "ip_address",
            "label": "IP Address",
            "type": "string",
            "required": true,
            "pattern": "[0-9.]+/[0-9]{1,2}"
        }
    ],

    "commands": [
        "/ip address add address={ip_address} interface={interface}"
    ]
}
