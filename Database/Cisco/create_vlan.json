{
    "id": "create_vlan",
    "name": "Create VLAN",
    "description": "Create a VLAN and optionally assign it a name.",
    "inputs": [
        {
            "name": "vlan_id",
            "label": "VLAN ID",
            "type": "integer",
            "required": true,
            "min": 1,
            "max": 4094
        },
        {
            "name": "vlan_name",
            "label": "VLAN Name",
            "type": "string",
            "required": true
        }
    ],
    "commands": [
        "configure terminal",
        "vlan {vlan_id}",
        "name {vlan_name}",
        "end"
    ]
}
